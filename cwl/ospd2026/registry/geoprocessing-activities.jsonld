{
  "@context": {
    "id": "@id",
    "type": "@type",
    "label": "skos:prefLabel",
    "definition": "skos:definition",
    "skos": "http://www.w3.org/2004/02/skos/core#",
    "schema": "https://schema.org/",
    "prov": "http://www.w3.org/ns/prov#",
    "ospd": "https://www.opengis.net/def/ospd/2026/",
    "ex": "http://example.org/"
  },
  "@graph": [
    {"id": "", "type": "skos:ConceptScheme", "label": "Provisional geoprocessing activities", "schema:description": "Reusable activities selected from Lightning2EarthCARE code clusters."},
    {"id": "#draftStatus", "schema:memberOf": {"id": ""}, "schema:value": {"id": "https://def.isotc211.org/codeset/ItemStatus/experimental"}},
    {"id": "#contributor", "prov:agent": {"id": "https://github.com/sunnydean"}, "prov:hadRole": {"id": "https://def.isotc211.org/codeset/RoleCode/contributor"}},
    {
      "id": "#collocation", "type": ["skos:Concept", "ospd:GeoprocessingActivity"],
      "label": "Multi-sensor observation matching",
      "definition": "Match observations from different sensors by location and acquisition time, accounting for viewing-geometry offsets where needed.",
      "prov:wasDerivedFrom": {"id": "../annotations.ttl#cluster_3"},
      "skos:relatedMatch": {"id": "http://ospd/demo/GA047"},
      "skos:scopeNote": "Lightning2EarthCARE retrieves and groups lightning observations, applies parallax correction and matches them to EarthCARE observations with along-track counts. Data Acquisition covers the retrieval component, not the matching operation.",
      "skos:inScheme": {"id": ""}, "ex:qualifiedStatus": {"id": "#draftStatus"}, "prov:qualifiedAttribution": {"id": "#contributor"}
    },
    {
      "id": "#aggregation", "type": ["skos:Concept", "ospd:GeoprocessingActivity"],
      "label": "Storm characterisation",
      "definition": "Estimate storm location, extent, duration, movement and lightning activity from grouped observations and satellite-track measurements.",
      "prov:wasDerivedFrom": {"id": "../annotations.ttl#cluster_4"},
      "skos:inScheme": {"id": ""}, "ex:qualifiedStatus": {"id": "#draftStatus"}, "prov:qualifiedAttribution": {"id": "#contributor"}
    },
    {
      "id": "#selection", "type": ["skos:Concept", "ospd:GeoprocessingActivity"],
      "label": "Satellite observation discovery",
      "definition": "Find satellite observations and sensor sources that meet time, geographic coverage and product requirements.",
      "prov:wasDerivedFrom": {"id": "../annotations.ttl#cluster_6"},
      "skos:relatedMatch": {"id": "http://ospd/demo/GA020"},
      "skos:scopeNote": "Covers catalogue queries and sensor-source selection within the orchestration group. Filter geometries addresses geometric filtering, not the combined time, product and sensor-coverage criteria.",
      "skos:inScheme": {"id": ""}, "ex:qualifiedStatus": {"id": "#draftStatus"}, "prov:qualifiedAttribution": {"id": "#contributor"}
    },
    {
      "id": "#conversion", "type": ["skos:Concept", "ospd:GeoprocessingActivity"],
      "label": "Geospatial feature construction",
      "definition": "Construct geospatial features from observation coordinates, associating measurements, times and identifiers.",
      "prov:wasDerivedFrom": {"id": "../annotations.ttl#cluster_7"},
      "skos:relatedMatch": {"id": "http://ospd/demo/GA044"},
      "skos:scopeNote": "Lightning2EarthCARE builds point geometries and attribute tables from NetCDF observations and storm records, then writes GeoParquet. Field Normalization covers attribute harmonisation, not feature construction.",
      "skos:inScheme": {"id": ""}, "ex:qualifiedStatus": {"id": "#draftStatus"}, "prov:qualifiedAttribution": {"id": "#contributor"}
    },
    {
      "id": "#stac", "type": ["skos:Concept", "ospd:GeoprocessingActivity"],
      "label": "Spatiotemporal dataset cataloguing",
      "definition": "Describe datasets by geographic extent, observation period and measured variables, linking each record to its data assets.",
      "prov:wasDerivedFrom": {"id": "../annotations.ttl#cluster_9"},
      "skos:inScheme": {"id": ""}, "ex:qualifiedStatus": {"id": "#draftStatus"}, "prov:qualifiedAttribution": {"id": "#contributor"}
    }
  ]
}
